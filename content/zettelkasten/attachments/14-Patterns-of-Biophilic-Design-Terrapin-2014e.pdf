   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">(CC) 2014 Creative Commons license</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Our apartment in Park Slope was about two blocks from Prospect Park, so we went there fairly often during the bright, sunny weather in the fall. I don't remember exactly when this was taken, but it gives a sense of the light, the color, and the overall peaceful atmosphere of the park -- designed by Frederick Law Olmstead, the same man who laid out Central Park in Manhattan.&#xA;&#xA;Emailed to Mom and Dad on 1/23/05</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Yourdon Edward</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>iPhoto Original</rdf:li>
    </rdf:Bag>
   </dc:subject>
  </rdf:Description>
 </rdf:RDF>
